# ========================================================
# SentinelAI Configuration Environment Variables
# ========================================================

# Host & Port
HOST=127.0.0.1
PORT=8000

# --------------------------------------------------------
# LLM Providers (All Free or Local!)
# --------------------------------------------------------
# 1. Google Gemini (Recommended - Free Tier): https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq Cloud (Free Tier - Ultra-fast Llama-3.3-70b): https://console.groq.com/
GROQ_API_KEY=

# 3. Local Ollama (100% Free & Offline): https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 4. Optional OpenAI
OPENAI_API_KEY=

# LLM Selection Mode: "auto", "gemini", "groq", "ollama", "openai", "heuristic"
# (If no keys provided, SentinelAI automatically uses its built-in Autonomous Heuristic Engine)
LLM_PROVIDER=auto

# --------------------------------------------------------
# Threat Intelligence Feeds (Optional - Offline DB included)
# --------------------------------------------------------
# AbuseIPDB API Key (Free tier 1,000 checks/day): https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# VirusTotal v3 API Key (Free tier 500 requests/day): https://www.virustotal.com/
VIRUSTOTAL_API_KEY=
